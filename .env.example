# Client-side Supabase values. The Afriframe-prefixed aliases are kept for compatibility.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AFRIFRAME_SUPABASE_URL=
VITE_AFRIFRAME_SUPABASE_ANON_KEY=

# Server-only Afriframe notification values
AFRIFRAME_SUPABASE_URL=
AFRIFRAME_SERVICE_ROLE_KEY=
RESEND_API_KEY=
AFRIFRAME_EMAIL_FROM="Afriframe Studio <notifications@your-domain.example>"
VAPID_SUBJECT="mailto:admin@your-domain.example"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional server fallbacks
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional application settings
# Public HTTPS URL of this app's POST /api/public/push-dispatch endpoint.
# Do not set this until the final Vercel domain is known.
AFRIFRAME_PUSH_DISPATCH_URL=
# Shared secret used only by Supabase pg_net and the server endpoint.
AFRIFRAME_PUSH_HOOK_SECRET=
AFRIFRAME_ADMIN_EMAIL=
AFRIFRAME_ADMIN_WHATSAPP=
